NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Orígenes permitidos para el frontend local. Evita usar * en producción.
CORS_ORIGIN=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,null

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=demo
DB_NAME=kwl_lavanderia

# Cambiar en cada despliegue real. Mínimo recomendado: 32 caracteres aleatorios.
AUTH_TOKEN_SECRET=change-this-secret
SUPER_ADMIN_LOGIN=admin@gmail.com

# Cámara 1. No incluir credenciales reales en el entregable.
CAMERA_BASE_URL=http://example.local
CAMERA_USER=demo_user
CAMERA_PASS=change_me
CAMERA_STREAM_USER=
CAMERA_STREAM_PASS=

# Cámara 2. No incluir credenciales reales en el entregable.
CAMERA2_BASE_URL=http://example.local
CAMERA2_USER=demo_user
CAMERA2_PASS=change_me
CAMERA2_STREAM_USER=
CAMERA2_STREAM_PASS=

MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=
MQTT_PASS=change_me

# Redis (cache de estado IoT / lectura rápida)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=1500
REDIS_KEY_PREFIX=kwl
