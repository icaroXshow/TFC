[Unit]
Description=KWL MQTT DB Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/kwl/backend
ExecStart=/var/www/kwl/backend/scripts/run_bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
